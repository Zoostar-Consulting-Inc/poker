<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.zoostarinc.poker</groupId>
	<artifactId>poker-parent</artifactId>
	<version>3.5.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<parent>
		<groupId>net.zoostar.boot</groupId>
		<artifactId>zoostar-boot-starter-parent</artifactId>
		<version>3.6.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<properties>
		<build.number>${user.name}</build.number>
		<build.timestamp>${maven.build.timestamp}</build.timestamp>
		<sonar.token>${SONAR_TOKEN}</sonar.token>
		<sonar.projectKey>zci_poker</sonar.projectKey>
		<sonar.organization>zoostar-consulting-inc</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
	</properties>
	<modules>
		<module>poker-api</module>
		<module>poker-spi</module>
		<module>poker-core</module>
	</modules>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>net.zoostar.common</groupId>
				<artifactId>zoostar-common</artifactId>
				<version>3.6.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**</include>
				</includes>
			</resource>
		</resources>
	</build>
	<name>Poker API</name>
	<url>https://poker.apigator.net</url>
	<description>Building RESTful APIs for Poker.
This project also servers as a template for creating any Java Enterprise projects on Spring Framework.</description>
	<organization>
		<name>Zoostar Cosulting, Inc.</name>
	</organization>
	<scm>
		<url>https://github.com/Zoostar-Consulting-Inc/poker-parent</url>
		<developerConnection>zoostar</developerConnection>
	</scm>
	<ciManagement>
		<system>Jenkins</system>
	</ciManagement>
</project>