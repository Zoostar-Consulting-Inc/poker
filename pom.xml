<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.zoostarinc.poker</groupId>
	<artifactId>poker-parent</artifactId>
	<version>3.0.0</version>
	<packaging>pom</packaging>
	<parent>
		<groupId>net.zoostar.boot</groupId>
		<artifactId>zoostar-boot-starter-parent</artifactId>
		<version>3.3.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<properties>
		<build.number>${user.name}</build.number>
		<build.timestamp>${maven.build.timestamp}</build.timestamp>
		<sonar.token>${SONAR_TOKEN}</sonar.token>
		<sonar.projectKey>zci_poker</sonar.projectKey>
		<sonar.organization>zoostar-consulting-inc</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
	</properties>
	<modules>
		<module>poker-api</module>
		<module>poker-core</module>
	</modules>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>net.zoostar.common</groupId>
				<artifactId>zoostar-common</artifactId>
				<version>3.3.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>